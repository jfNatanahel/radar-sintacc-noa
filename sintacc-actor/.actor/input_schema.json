{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "Radar Sin TACC · Inteligencia competitiva NOA",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "operation": {
            "title": "Operación",
            "type": "string",
            "description": "analytics = Producto 1 (ETL + EDA). inference = Producto 2.",
            "editor": "select",
            "enum": [
                "analytics",
                "inference"
            ],
            "enumTitles": [
                "Analytics: de los datos a la información",
                "Inference: de la información a las decisiones"
            ],
            "default": "analytics"
        },
        "source": {
            "sectionCaption": "Fuente de datos",
            "title": "Fuente",
            "type": "string",
            "description": "csv = los CSV del 12/11 guardados en el key-value store 'radar-sintacc-entrada' (rápido, casi sin costo). apify = extrae datos nuevos de Mercado Libre y Google Maps.",
            "editor": "select",
            "enum": [
                "csv",
                "apify"
            ],
            "enumTitles": [
                "CSV ya extraídos (demo)",
                "Extracción nueva con Apify"
            ],
            "default": "csv"
        },
        "mlActorId": {
            "sectionCaption": "Extracción nueva (fuente apify)",
            "title": "Extractor de Mercado Libre",
            "type": "string",
            "description": "ID o nombre del Actor de Mercado Libre usado el 12/11.",
            "editor": "textfield"
        },
        "mlInput": {
            "title": "Input del extractor de Mercado Libre",
            "type": "object",
            "description": "Input usado el 12/11, con {busqueda} en lugar del texto de búsqueda.",
            "editor": "json",
            "prefill": {}
        },
        "productos": {
            "title": "Productos",
            "type": "array",
            "description": "Categorías a extraer.",
            "editor": "stringList",
            "default": [
                "premezcla",
                "harina",
                "fideos",
                "rebozador",
                "pan"
            ]
        },
        "provincias": {
            "title": "Provincias",
            "type": "array",
            "description": "Se busca en la capital de cada una.",
            "editor": "stringList",
            "default": [
                "Salta",
                "Jujuy",
                "La Rioja"
            ]
        },
        "maxPorBusqueda": {
            "title": "Máximo de locales por búsqueda",
            "type": "integer",
            "description": "Controla el costo de Google Maps.",
            "editor": "number",
            "minimum": 5,
            "maximum": 200,
            "default": 40
        }
    },
    "required": [
        "operation"
    ]
}
